{
  "info": {
    "_postman_id": "b5b090f1-ef43-46b9-b0f9-447e8dfde501",
    "name": "Baozi Store API - Atividade Prática",
    "description": "Sequência de teste da API REST Baozi Store. Antes de executar, altere o RU no primeiro POST. Capture os prints reais antes de executar os DELETE.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - POST Cliente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/clientes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "clientes"
          ]
        },
        "description": "Cria o cliente do estudo de caso. Substitua o texto RU PREENCHER pelo RU real antes do teste.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Raquel Valentim - RU PREENCHER\",\n  \"clienteDesde\": \"2026-10-12\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201 - cliente criado\", function () { pm.response.to.have.status(201); });",
              "const data = pm.response.json();",
              "pm.expect(data.id).to.exist;",
              "pm.environment.set(\"clienteId\", String(data.id));"
            ]
          }
        }
      ]
    },
